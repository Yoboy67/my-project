<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Luca Enterprise — Official Corporate Portal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=IBM+Plex+Mono:wght@300;400;500&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f0ede6;
      --bg2: #e8e4db;
      --bg3: #ffffff;
      --ink: #1a1814;
      --ink2: #4a4640;
      --ink3: #8a8680;
      --red: #8b1a1a;
      --border: rgba(26,24,20,0.15);
      --border-strong: rgba(26,24,20,0.4);
      --mono: 'IBM Plex Mono', monospace;
      --serif: 'EB Garamond', serif;
      --display: 'Playfair Display', serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { background: var(--bg); color: var(--ink); font-family: var(--serif); font-size: 16px; line-height: 1.7; min-height: 100vh; }
    .site-wrap { max-width: 980px; margin: 0 auto; padding: 0 2rem; }
    .page { display: none; animation: fadeIn 0.3s ease; }
    .page.active { display: block; }
    @keyframes fadeIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }

    /* HEADER */
    .le-header { padding: 2.5rem 0 1.5rem; border-bottom: 1px solid var(--border-strong); }
    .le-header-inner { display:flex; align-items:flex-end; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
    .le-brand { cursor:pointer; }
    .le-logo-box { display:inline-flex; align-items:center; gap:1rem; }
    .le-logo-mark { width:48px; height:48px; border:2px solid var(--ink); display:flex; align-items:center; justify-content:center; font-family:var(--display); font-weight:900; font-size:22px; flex-shrink:0; }
    .le-logo-name { font-family:var(--display); font-size:22px; font-weight:700; letter-spacing:0.05em; line-height:1.1; }
    .le-logo-tagline { font-family:var(--mono); font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:var(--ink3); }
    .le-header-meta { text-align:right; font-family:var(--mono); font-size:10px; color:var(--ink3); line-height:1.8; }
    .le-ticker { display:inline-block; background:var(--ink); color:var(--bg); padding:2px 8px; font-family:var(--mono); font-size:9px; letter-spacing:0.1em; margin-top:4px; }

    /* NAV */
    .le-nav { border-bottom:1px solid var(--border); background:var(--bg2); position:sticky; top:0; z-index:100; }
    .le-nav-inner { display:flex; align-items:center; overflow-x:auto; }
    .le-nav-btn { font-family:var(--mono); font-size:10px; letter-spacing:0.15em; text-transform:uppercase; padding:14px 18px; background:none; border:none; border-right:1px solid var(--border); color:var(--ink2); cursor:pointer; white-space:nowrap; transition:background 0.2s,color 0.2s; position:relative; }
    .le-nav-btn:hover { background:var(--bg); color:var(--ink); }
    .le-nav-btn.active { background:var(--bg3); color:var(--ink); border-bottom:2px solid var(--ink); }

    /* PAGE */
    .page-content { padding:3rem 0 5rem; }

    /* HERO */
    .le-hero { display:grid; grid-template-columns:1fr 300px; gap:3rem; align-items:start; margin-bottom:4rem; padding-bottom:3rem; border-bottom:1px solid var(--border); }
    .le-hero-title { font-family:var(--display); font-size:clamp(48px,7vw,84px); font-weight:900; line-height:0.92; letter-spacing:-0.02em; margin-bottom:1.5rem; }
    .le-hero-title em { font-style:italic; color:var(--red); }
    .le-hero-body { font-size:15px; color:var(--ink2); line-height:1.8; margin-bottom:1.5rem; }
    .le-stamp-wrap { display:flex; gap:1rem; flex-wrap:wrap; }
    .le-stamp { display:inline-block; border:2px solid var(--red); color:var(--red); padding:5px 14px; font-family:var(--mono); font-size:9px; letter-spacing:0.2em; text-transform:uppercase; transform:rotate(-1.5deg); font-weight:500; }
    .le-stamp-2 { transform:rotate(0.8deg); border-color:var(--ink); color:var(--ink); }
    .le-stat-card { border:1px solid var(--border-strong); background:var(--bg3); padding:1.2rem 1.4rem; margin-bottom:1rem; }
    .le-stat-num { font-family:var(--mono); font-size:30px; font-weight:500; line-height:1; }
    .le-stat-label { font-family:var(--mono); font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:var(--ink3); margin-top:4px; }
    .le-stat-note { font-size:11px; color:var(--ink3); font-style:italic; margin-top:6px; }

    /* TABLE */
    .le-doc-table { width:100%; border-collapse:collapse; font-family:var(--mono); font-size:11.5px; margin-bottom:0.5rem; }
    .le-doc-table th { text-align:left; font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:var(--ink3); border-bottom:1px solid var(--border-strong); padding:8px 12px; font-weight:400; }
    .le-doc-table td { padding:12px 12px; border-bottom:1px solid var(--border); vertical-align:middle; }
    .le-doc-table tr.clickable { cursor:pointer; transition:background 0.15s; }
    .le-doc-table tr.clickable:hover td { background:var(--bg2); }
    .le-doc-table tr.clickable:hover .doc-title { text-decoration:underline; }
    .le-badge { display:inline-block; font-family:var(--mono); font-size:8px; letter-spacing:0.12em; text-transform:uppercase; padding:2px 6px; border:1px solid; margin-left:6px; vertical-align:middle; }
    .badge-red { color:var(--red); border-color:var(--red); }
    .badge-gray { color:var(--ink3); border-color:var(--border-strong); }
    .badge-green { color:#1a5c1a; border-color:#1a5c1a; }

    /* SECTION */
    .le-sec-head { display:flex; align-items:baseline; gap:1rem; margin-bottom:1.5rem; flex-wrap:wrap; }
    .le-sec-title { font-family:var(--display); font-size:28px; font-weight:700; }
    .le-sec-num { font-family:var(--mono); font-size:11px; color:var(--ink3); letter-spacing:0.1em; }
    .le-section-block { margin-bottom:3.5rem; }

    /* LEGAL */
    .le-legal { background:var(--bg3); border:1px solid var(--border); border-left:3px solid var(--ink); padding:1.4rem 1.8rem; margin-bottom:1.2rem; font-size:13px; line-height:1.9; color:var(--ink2); }
    .le-legal-head { font-family:var(--mono); font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:var(--ink3); margin-bottom:0.6rem; }
    .le-legal em { color:var(--ink); font-style:italic; }

    /* REDACTED */
    .redacted { background:var(--ink); color:var(--ink); cursor:pointer; padding:0 3px; transition:all 0.3s; user-select:none; border-radius:1px; }
    .redacted:hover { background:var(--ink2); }
    .redacted.shown { background:transparent; color:var(--red); font-weight:600; }

    /* WARNING */
    .le-warning { border:1px solid var(--red); padding:1rem 1.4rem; font-family:var(--mono); font-size:11px; color:var(--red); line-height:1.8; margin:1.5rem 0; background:rgba(139,26,26,0.03); }
    .le-warning-head { font-size:9px; letter-spacing:0.2em; text-transform:uppercase; font-weight:500; margin-bottom:0.4rem; }

    /* HIDDEN MEMO */
    .le-hidden { font-family:var(--mono); font-size:10px; color:var(--border-strong); text-align:center; padding:1.5rem 0; letter-spacing:0.05em; cursor:default; transition:color 0.4s; line-height:2; }
    .le-hidden:hover { color:var(--red); }

    /* DIVIDER */
    .le-divider { border:none; border-top:1px solid var(--border); margin:2.5rem 0; }

    /* FORM */
    .le-form-wrap { display:grid; grid-template-columns:1fr 1fr; gap:3rem; }
    .le-form-group { margin-bottom:1.4rem; }
    .le-label { display:block; font-family:var(--mono); font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:var(--ink3); margin-bottom:6px; }
    .le-input, .le-select, .le-textarea { width:100%; background:var(--bg3); border:1px solid var(--border-strong); padding:10px 14px; font-family:var(--serif); font-size:14px; color:var(--ink); outline:none; transition:border-color 0.2s; appearance:none; }
    .le-input:focus,.le-select:focus,.le-textarea:focus { border-color:var(--ink); }
    .le-textarea { resize:vertical; min-height:120px; }
    .le-select { cursor:pointer; }
    .le-btn { display:inline-block; background:var(--ink); color:var(--bg); font-family:var(--mono); font-size:10px; letter-spacing:0.2em; text-transform:uppercase; padding:12px 28px; border:none; cursor:pointer; transition:background 0.2s; }
    .le-btn:hover { background:var(--ink2); }
    .le-btn-ghost { background:transparent; color:var(--ink); border:1px solid var(--border-strong); }
    .le-btn-ghost:hover { background:var(--bg2); }
    .le-form-sidebar { border-left:1px solid var(--border); padding-left:3rem; }
    .le-contact-item { padding:1rem 0; border-bottom:1px solid var(--border); font-size:13px; }
    .le-contact-item-label { font-family:var(--mono); font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:var(--ink3); margin-bottom:4px; }
    .le-contact-item-val { color:var(--ink2); font-style:italic; }

    /* COMPLIANCE GRID */
    .le-compliance-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--border); border:1px solid var(--border); margin-bottom:2rem; }
    .le-compliance-cell { background:var(--bg3); padding:1.2rem; }
    .le-compliance-status { font-family:var(--mono); font-size:9px; letter-spacing:0.15em; text-transform:uppercase; margin-bottom:0.4rem; }
    .status-ok { color:#1a5c1a; }
    .status-warn { color:#7a5a00; }
    .status-err { color:var(--red); }
    .le-compliance-name { font-size:13px; color:var(--ink); margin-bottom:4px; }
    .le-compliance-note { font-family:var(--mono); font-size:10px; color:var(--ink3); }

    /* DISCOGRAPHY */
    .le-disco-item { display:grid; grid-template-columns:80px 1fr auto; align-items:center; gap:1.5rem; padding:1.2rem 0.5rem; border-bottom:1px solid var(--border); cursor:default; transition:background 0.15s,padding 0.15s; }
    .le-disco-item:hover { background:var(--bg2); }
    .le-disco-num { font-family:var(--mono); font-size:11px; color:var(--ink3); letter-spacing:0.1em; }
    .le-disco-title { font-family:var(--display); font-size:18px; font-weight:700; }
    .le-disco-meta { font-family:var(--mono); font-size:10px; color:var(--ink3); margin-top:2px; }
    .le-disco-filed { font-family:var(--mono); font-size:10px; color:var(--ink3); text-align:right; }

    /* MODAL */
    .modal-backdrop { display:none; position:fixed; inset:0; background:rgba(26,24,20,0.75); z-index:1000; align-items:center; justify-content:center; padding:2rem; }
    .modal-backdrop.open { display:flex; }
    .modal-box { background:var(--bg); max-width:640px; width:100%; max-height:80vh; overflow-y:auto; border:1px solid var(--border-strong); animation:modalIn 0.25s ease; }
    @keyframes modalIn { from{opacity:0;transform:scale(0.97) translateY(10px);} to{opacity:1;transform:scale(1) translateY(0);} }
    .modal-head { display:flex; align-items:center; justify-content:space-between; padding:1.2rem 1.6rem; border-bottom:1px solid var(--border-strong); background:var(--bg2); position:sticky; top:0; }
    .modal-title { font-family:var(--mono); font-size:10px; letter-spacing:0.2em; text-transform:uppercase; }
    .modal-close { background:none; border:1px solid var(--border-strong); width:28px; height:28px; display:flex; align-items:center; justify-content:center; cursor:pointer; font-family:var(--mono); font-size:14px; color:var(--ink2); transition:background 0.2s; }
    .modal-close:hover { background:var(--bg3); }
    .modal-body { padding:2rem 1.6rem; }

    /* TOAST */
    .le-toast { position:fixed; bottom:2rem; right:2rem; background:var(--ink); color:var(--bg); font-family:var(--mono); font-size:11px; letter-spacing:0.05em; padding:12px 20px; z-index:2000; transform:translateY(100px); opacity:0; transition:all 0.3s; max-width:340px; line-height:1.6; }
    .le-toast.show { transform:translateY(0); opacity:1; }

    /* GLITCH */
    .glitch { cursor:default; display:inline-block; }
    .glitch:hover { animation:glitch 0.3s infinite; color:var(--red); }
    @keyframes glitch { 0%,100%{transform:translate(0);} 20%{transform:translate(-2px,1px);} 40%{transform:translate(2px,-1px);} 60%{transform:translate(-1px,2px);} 80%{transform:translate(1px,-2px);} }

    /* FOOTER */
    .le-footer { border-top:1px solid var(--border-strong); padding:2rem 0 3rem; display:grid; grid-template-columns:1fr 1fr 1fr; gap:2rem; font-family:var(--mono); font-size:10px; color:var(--ink3); line-height:2; }
    .le-footer-col-title { font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:var(--ink2); margin-bottom:0.5rem; }
    .le-footer-bottom { border-top:1px solid var(--border); padding:1rem 0 2rem; font-family:var(--mono); font-size:9px; color:var(--ink3); letter-spacing:0.05em; display:flex; justify-content:space-between; flex-wrap:wrap; gap:0.5rem; }

    /* RESPONSIVE */
    @media(max-width:720px){
      .le-hero{grid-template-columns:1fr;}
      .le-form-wrap{grid-template-columns:1fr;}
      .le-form-sidebar{border-left:none;border-top:1px solid var(--border);padding-left:0;padding-top:2rem;}
      .le-footer{grid-template-columns:1fr;}
      .le-compliance-grid{grid-template-columns:1fr 1fr;}
      .le-hero-title{font-size:48px;}
    }
    @media(max-width:500px){
      .site-wrap{padding:0 1rem;}
      .le-compliance-grid{grid-template-columns:1fr;}
      .le-disco-item{grid-template-columns:50px 1fr;}
      .le-disco-filed{display:none;}
    }
  </style>
</head>
