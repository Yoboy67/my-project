<div id="le-toast" class="le-toast"></div>

<script>
  function showPage(name, btn) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.le-nav-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('page-' + name).classList.add('active');
    if (btn) btn.classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  function goHome() {
    showPage('home', document.querySelectorAll('.le-nav-btn')[0]);
  }
  function openModal(id) {
    document.getElementById(id).classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeModal(id) {
    document.getElementById(id).classList.remove('open');
    document.body.style.overflow = '';
  }
  function closeModalOutside(e, backdrop) {
    if (e.target === backdrop) { backdrop.classList.remove('open'); document.body.style.overflow = ''; }
  }
  function showToast(msg) {
    const t = document.getElementById('le-toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 4500);
  }
  function submitContact() {
    if (!document.getElementById('terms-check').checked) {
      showToast('You must agree to the Terms & Conditions. (You already have. Please check the box anyway.)');
      return;
    }
    showToast('Inquiry submitted. Receipt of inquiry does not imply review.');
  }
  function submitComplaint() {
    showToast('Complaint No. ' + Math.floor(Math.random()*9000+1000) + ' filed. Review timeline: undisclosed.');
  }
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.modal-backdrop.open').forEach(m => { m.classList.remove('open'); document.body.style.overflow = ''; });
    }
  });
</script>
